{
  "mcpServers": {
    "hwpx": {
      "command": "uv",
      "args": [
        "run",
        "--isolated",
        "--no-project",
        "--no-config",
        "--no-env-file",
        "--python",
        "3.12",
        "python",
        "-I",
        "-c",
        "import base64,hashlib,json,os,sys,tempfile,zlib\nfrom pathlib import Path\nsource,arguments=json.loads(zlib.decompress(base64.b64decode(sys.argv[1])))\ncode=source.encode('utf-8')\nbase=Path(os.environ.get('LOCALAPPDATA',str(Path.home()/'.cache'))) if os.name=='nt' else Path(os.environ.get('XDG_CACHE_HOME',str(Path.home()/'.cache')))\nif os.name=='nt':base=Path('\\\\\\\\?\\\\'+os.path.abspath(base))\nroot=base/'hwpx-plugin'/'python-launchers'/hashlib.sha256(code).hexdigest()\nroot.mkdir(parents=True,exist_ok=True)\nscript=root/'launcher.py'\nif not script.exists():\n    fd,name=tempfile.mkstemp(prefix='.launcher-',dir=root)\n    try:\n        with os.fdopen(fd,'wb') as output:output.write(code)\n        os.replace(name,script)\n    finally:\n        if os.path.exists(name):os.unlink(name)\nif script.is_symlink() or script.read_bytes()!=code:raise ValueError('HWPX launcher source verification failed')\nsys.argv=[str(script),*arguments,*sys.argv[2:]]\nexec(compile(code,str(script),'exec'),{'__name__':'__main__','__file__':str(script)})\n",
        ""
      ],
      "env": {
        "HWPX_AUTOMATION_AUTOBACKUP": "1",
        "HWPX_SKILL_VERSION": "2.4.0"
      },
      "env_vars": [
        "HWPX_AUTOMATION_ADVANCED",
        "HWPX_AUTOMATION_CHROME_PATH",
        "HWPX_AUTOMATION_DISABLE_LOCAL_EDITABLE",
        "HWPX_AUTOMATION_PACKAGE",
        "HWPX_AUTOMATION_RUNTIME_ROOT",
        "HWPX_AUTOMATION_WORKSPACE_ROOTS",
        "HWPX_MCP_CHROME_PATH",
        "HWPX_ORACLE_BUDGET_SECONDS",
        "HWPX_ORACLE_STRUCTURAL_ONLY",
        "HWPX_PYTHON_HWPX_PACKAGE",
        "HWPX_RENDER_CA_FILE",
        "HWPX_RENDER_CLIENT_CERT_FILE",
        "HWPX_RENDER_CLIENT_KEY_FILE",
        "HWPX_RENDER_QUEUE_ROOT",
        "HWPX_RENDER_QUEUE_SECRET",
        "HWPX_RENDER_QUEUE_URL",
        "HWPX_RENDER_TRANSPORT_AUTH",
        "HWPX_STACK_AUTO_UPDATE",
        "HWPX_STACK_CHANNEL",
        "HWPX_STACK_UPDATE_INTERVAL_HOURS"
      ],
      "startup_timeout_sec": 180
    },
    "hwpx_native_preview": {
      "command": "uv",
      "args": [
        "run",
        "--isolated",
        "--no-project",
        "--no-config",
        "--no-env-file",
        "--python",
        "3.12",
        "python",
        "-I",
        "-c",
        "import base64,hashlib,json,os,sys,tempfile,zlib\nfrom pathlib import Path\nsource,arguments=json.loads(zlib.decompress(base64.b64decode(sys.argv[1])))\ncode=source.encode('utf-8')\nbase=Path(os.environ.get('LOCALAPPDATA',str(Path.home()/'.cache'))) if os.name=='nt' else Path(os.environ.get('XDG_CACHE_HOME',str(Path.home()/'.cache')))\nif os.name=='nt':base=Path('\\\\\\\\?\\\\'+os.path.abspath(base))\nroot=base/'hwpx-plugin'/'python-launchers'/hashlib.sha256(code).hexdigest()\nroot.mkdir(parents=True,exist_ok=True)\nscript=root/'launcher.py'\nif not script.exists():\n    fd,name=tempfile.mkstemp(prefix='.launcher-',dir=root)\n    try:\n        with os.fdopen(fd,'wb') as output:output.write(code)\n        os.replace(name,script)\n    finally:\n        if os.path.exists(name):os.unlink(name)\nif script.is_symlink() or script.read_bytes()!=code:raise ValueError('HWPX launcher source verification failed')\nsys.argv=[str(script),*arguments,*sys.argv[2:]]\nexec(compile(code,str(script),'exec'),{'__name__':'__main__','__file__':str(script)})\n",
        ""
      ],
      "startup_timeout_sec": 180
    }
  }
}
