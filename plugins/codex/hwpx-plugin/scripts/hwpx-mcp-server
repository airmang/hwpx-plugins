#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SERVER_PACKAGE="hwpx-mcp-server==2.8.0"
export HWPX_SKILL_VERSION="${HWPX_SKILL_VERSION:-0.1.12}"
export HWPX_PLUGIN_ROOT="${HWPX_PLUGIN_ROOT:-${PLUGIN_ROOT}}"

find_stack_root() {
  local dir="$1"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/hwpx-mcp-server/pyproject.toml" ] && [ -f "$dir/python-hwpx/pyproject.toml" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

STACK_ROOT=""
if ! STACK_ROOT="$(find_stack_root "$SCRIPT_DIR")"; then
  STACK_ROOT=""
fi

MCP_REPO="${HWPX_MCP_SERVER_REPO:-${STACK_ROOT:+$STACK_ROOT/hwpx-mcp-server}}"
PYTHON_HWPX_REPO="${PYTHON_HWPX_REPO:-${STACK_ROOT:+$STACK_ROOT/python-hwpx}}"

if command -v uv >/dev/null 2>&1 \
  && [ -n "${MCP_REPO}" ] && [ -f "${MCP_REPO}/pyproject.toml" ] \
  && [ -n "${PYTHON_HWPX_REPO}" ] && [ -f "${PYTHON_HWPX_REPO}/pyproject.toml" ]; then
  exec uv run --no-project --with-editable "${PYTHON_HWPX_REPO}" --with-editable "${MCP_REPO}" hwpx-mcp-server
fi

if command -v uv >/dev/null 2>&1; then
  VENV_DIR="${HWPX_MCP_SERVER_VENV:-${PLUGIN_ROOT}/.hwpx-mcp-server-venv}"
  VERSION_FILE="${VENV_DIR}/.hwpx-mcp-server-package"
  SERVER_BIN="${VENV_DIR}/bin/hwpx-mcp-server"

  if [ ! -x "${SERVER_BIN}" ] || [ ! -f "${VERSION_FILE}" ] || [ "$(cat "${VERSION_FILE}")" != "${SERVER_PACKAGE}" ]; then
    rm -rf "${VENV_DIR}"
    uv venv --quiet "${VENV_DIR}"
    uv pip install --quiet \
      --refresh-package hwpx-mcp-server \
      --refresh-package python-hwpx \
      --python "${VENV_DIR}/bin/python" \
      "${SERVER_PACKAGE}"
    printf '%s\n' "${SERVER_PACKAGE}" > "${VERSION_FILE}"
  fi

  exec "${SERVER_BIN}"
fi

if command -v uvx >/dev/null 2>&1; then
  exec uvx \
    --refresh-package hwpx-mcp-server \
    --refresh-package python-hwpx \
    --from "${SERVER_PACKAGE}" \
    hwpx-mcp-server
fi

echo "hwpx-plugin requires uv or uvx to install and run ${SERVER_PACKAGE}. Install uv, or set HWPX_MCP_SERVER_REPO and PYTHON_HWPX_REPO to local checkouts." >&2
exit 127
