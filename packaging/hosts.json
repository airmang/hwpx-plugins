{
  "schemaVersion": "hwpx.packaging.v1",
  "identityFile": "product-identity.json",
  "canonicalSkill": "SKILL.md",
  "launcherTemplate": "templates/hwpx-mcp-server",
  "sharedAssets": [
    "README.md",
    "CHANGELOG.md",
    "packaging/product-identity.json",
    "references/api.md",
    "references/evidence-contract.md",
    "references/government-report-visual-review.md",
    "references/official-document-rules.md",
    "references/tool-contract.generated.md",
    "references/tool-contract.generated.json",
    "references/workflows-toc.md",
    "references/workflows-autonomous.md",
    "references/workflows-agent-document.md",
    "references/workflows-agent-blueprint.md",
    "references/workflows-real-hancom-render.md",
    "references/workflows-authoring.md",
    "references/workflows-bulk-compare.md",
    "references/workflows-creation.md",
    "references/workflows-reading.md",
    "references/workflows-redline.md",
    "references/workflows-pii.md",
    "references/workflows-editing.md",
    "references/workflows-exam.md",
    "references/workflows-forms.md",
    "references/workflows-preview.md",
    "references/migration-5.0.md",
    "examples/01_create_and_save.py",
    "examples/02_extract_and_inspect.py",
    "examples/03_template_replace.py",
    "examples/04_create_proposal.py",
    "examples/05_mcp_quality_pipeline.md",
    "examples/06_create_from_document_plan.py",
    "examples/06_mcp_document_plan.md",
    "examples/07_create_operating_plan.py",
    "examples/07_mcp_operating_plan.md",
    "examples/08_template_formfit.py",
    "examples/08_mcp_canonical_form_fill.md",
    "examples/09_visual_review_loop.md",
    "examples/10_create_with_builder.py",
    "examples/11_official_document_recipes.py",
    "examples/12_task_eval_replay.md",
    "examples/13_advanced_generators.py",
    "examples/14_mail_merge_table_compute.py",
    "examples/eval_tasks/tasks.json",
    "examples/eval_tasks/profiles/current-0.7.0.json",
    "examples/eval_tasks/profiles/current-0.3.0.json",
    "examples/eval_tasks/profiles/current-0.1.8.json",
    "examples/eval_tasks/profiles/current-0.1.6.json",
    "examples/eval_tasks/profiles/baseline-0.1.5.json",
    "scripts/fix_namespaces.py",
    "scripts/quickcheck.py",
    "scripts/task_eval_harness.py",
    "scripts/text_extract.py",
    "scripts/visual_review.py",
    "scripts/zip_replace_all.py"
  ],
  "repoRootArtifacts": [
    { "template": "templates/claude.marketplace.json", "dest": ".claude-plugin/marketplace.json" },
    { "template": "templates/codex.marketplace.json", "dest": ".agents/plugins/marketplace.json" }
  ],
  "hosts": [
    {
      "id": "claude",
      "outputDir": "plugins/claude/hwpx-plugin",
      "skillSubdir": "skills/hwpx",
      "frontmatterExtra": "",
      "manifests": [{ "template": "templates/claude.plugin.json", "dest": ".claude-plugin/plugin.json" }],
      "mcp": { "strategy": "bundled", "template": "templates/claude.mcp.json", "dest": ".mcp.json" },
      "bundleLauncher": true
    },
    {
      "id": "codex",
      "outputDir": "plugins/codex/hwpx-plugin",
      "skillSubdir": "skills/hwpx",
      "frontmatterExtra": "",
      "manifests": [{ "template": "templates/codex.plugin.json", "dest": ".codex-plugin/plugin.json" }],
      "mcp": { "strategy": "bundled", "template": "templates/codex.mcp.json", "dest": ".mcp.json" },
      "bundleLauncher": true
    },
    {
      "id": "openclaw",
      "outputDir": "plugins/openclaw/hwpx-plugin",
      "skillSubdir": "skills/hwpx",
      "frontmatterExtra": "",
      "manifests": [{ "template": "templates/openclaw.plugin.json", "dest": "openclaw.plugin.json" }],
      "mcp": { "strategy": "config-doc", "template": "templates/openclaw.mcp-install.md", "dest": "INSTALL-mcp.md" },
      "bundleLauncher": false
    },
    {
      "id": "hermes",
      "outputDir": "plugins/hermes/hwpx",
      "skillSubdir": ".",
      "includeVersionFrontmatter": true,
      "frontmatterExtra": "author: airmang\nlicense: Apache-2.0\nmetadata:\n  hermes:\n    tags: [productivity, documents, hwpx, korean-documents]\n    category: productivity",
      "manifests": [],
      "mcp": { "strategy": "config-doc", "template": "templates/hermes.mcp-install.md", "dest": "INSTALL-mcp.md" },
      "bundleLauncher": false
    }
  ]
}
