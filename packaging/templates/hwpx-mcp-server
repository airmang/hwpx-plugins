#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SERVER_PACKAGE="${HWPX_MCP_SERVER_PACKAGE:-hwpx-mcp-server==4.3.0}"
CORE_PACKAGE="${HWPX_PYTHON_HWPX_PACKAGE:-python-hwpx[visual]==3.3.1}"
EXPECTED_SERVER_VERSION="${HWPX_MCP_SERVER_VERSION:-4.3.0}"
EXPECTED_CORE_VERSION="${HWPX_PYTHON_HWPX_VERSION:-3.3.1}"
export HWPX_SKILL_VERSION="${HWPX_SKILL_VERSION:-0.6.0}"
export HWPX_PLUGIN_ROOT="${HWPX_PLUGIN_ROOT:-${PLUGIN_ROOT}}"

find_stack_root() {
  local dir="$1"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/hwpx-mcp-server/pyproject.toml" ] && [ -f "$dir/python-hwpx/pyproject.toml" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

STACK_ROOT=""
if ! STACK_ROOT="$(find_stack_root "$SCRIPT_DIR")"; then
  STACK_ROOT=""
fi

MCP_REPO="${HWPX_MCP_SERVER_REPO:-${STACK_ROOT:+$STACK_ROOT/hwpx-mcp-server}}"
PYTHON_HWPX_REPO="${PYTHON_HWPX_REPO:-${STACK_ROOT:+$STACK_ROOT/python-hwpx}}"

if [ "${HWPX_MCP_DISABLE_LOCAL_EDITABLE:-0}" != "1" ] \
  && command -v uv >/dev/null 2>&1 \
  && [ -n "${MCP_REPO}" ] && [ -f "${MCP_REPO}/pyproject.toml" ] \
  && [ -n "${PYTHON_HWPX_REPO}" ] && [ -f "${PYTHON_HWPX_REPO}/pyproject.toml" ]; then
  exec uv run --no-project --no-sources \
    --with-editable "${PYTHON_HWPX_REPO}[visual]" \
    --with-editable "${MCP_REPO}" \
    hwpx-mcp-server "$@"
fi

if command -v uv >/dev/null 2>&1; then
  RUNTIME_ROOT="${HWPX_MCP_RUNTIME_ROOT:-${HWPX_MCP_SERVER_VENV:-${PLUGIN_ROOT}/.hwpx-mcp-runtime}}"
  ENV_ROOT="${RUNTIME_ROOT}/envs"
  LOCK_DIR="${RUNTIME_ROOT}/install.lock"
  RECOVERY_LOCK_DIR="${RUNTIME_ROOT}/install.lock.recovery"
  mkdir -p "${ENV_ROOT}"

  UV_PYTHON="$(uv python find)"
  FINGERPRINT="$(
    "${UV_PYTHON}" - "${SERVER_PACKAGE}" "${CORE_PACKAGE}" "${HWPX_SKILL_VERSION}" <<'PY'
import hashlib
import json
import platform
import sys
import sysconfig

payload = {
    "serverPackage": sys.argv[1],
    "corePackage": sys.argv[2],
    "skillVersion": sys.argv[3],
    "implementation": sys.implementation.name,
    "python": platform.python_version(),
    "abi": sysconfig.get_config_var("SOABI"),
    "platform": sysconfig.get_platform(),
}
encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
print(hashlib.sha256(encoded).hexdigest())
PY
  )"

  VENV_DIR="${ENV_ROOT}/${FINGERPRINT}"
  VERSION_FILE="${VENV_DIR}/.hwpx-stack-fingerprint"
  RUNTIME_PYTHON="${VENV_DIR}/bin/python"

  runtime_ready() {
    [ -x "${RUNTIME_PYTHON}" ] \
      && [ -f "${VERSION_FILE}" ] \
      && [ "$(cat "${VERSION_FILE}")" = "${FINGERPRINT}" ]
  }

  if ! runtime_ready; then
    acquired=0
    for _attempt in $(seq 1 1200); do
      if [ -d "${RECOVERY_LOCK_DIR}" ]; then
        sleep 0.1
        continue
      fi
      if mkdir "${LOCK_DIR}" 2>/dev/null; then
        printf '%s\n' "$$" > "${LOCK_DIR}/pid"
        acquired=1
        break
      fi
      lock_pid=""
      if [ -f "${LOCK_DIR}/pid" ]; then
        lock_pid="$(cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
      fi
      if [ -n "${lock_pid}" ] && ! kill -0 "${lock_pid}" 2>/dev/null; then
        if mkdir "${RECOVERY_LOCK_DIR}" 2>/dev/null; then
          current_lock_pid="$(cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
          if [ "${current_lock_pid}" = "${lock_pid}" ] \
            && ! kill -0 "${current_lock_pid}" 2>/dev/null; then
            stale_lock="${RUNTIME_ROOT}/install.lock.stale.$$.$_attempt"
            if mv "${LOCK_DIR}" "${stale_lock}" 2>/dev/null; then
              rm -rf "${stale_lock}"
            fi
          fi
          rmdir "${RECOVERY_LOCK_DIR}" 2>/dev/null || true
        fi
        continue
      fi
      sleep 0.1
    done
    if [ "${acquired}" != "1" ]; then
      echo "timed out waiting for the HWPX runtime installation lock" >&2
      exit 75
    fi

    BUILD_DIR="${RUNTIME_ROOT}/.build-${FINGERPRINT}-$$"
    cleanup_runtime_build() {
      rm -rf "${BUILD_DIR}"
      rm -rf "${LOCK_DIR}"
    }
    trap cleanup_runtime_build EXIT INT TERM

    if ! runtime_ready; then
      rm -rf "${BUILD_DIR}"
      uv venv --quiet "${BUILD_DIR}"
      uv pip install --quiet \
        --refresh-package hwpx-mcp-server \
        --refresh-package python-hwpx \
        --python "${BUILD_DIR}/bin/python" \
        "${SERVER_PACKAGE}" \
        "${CORE_PACKAGE}"
      "${BUILD_DIR}/bin/python" - "${EXPECTED_SERVER_VERSION}" "${EXPECTED_CORE_VERSION}" <<'PY'
from importlib.metadata import version
import sys

expected_server, expected_core = sys.argv[1:]
observed = {
    "hwpx-mcp-server": version("hwpx-mcp-server"),
    "python-hwpx": version("python-hwpx"),
}
expected = {
    "hwpx-mcp-server": expected_server,
    "python-hwpx": expected_core,
}
if observed != expected:
    raise SystemExit(f"installed HWPX stack version mismatch: {observed!r} != {expected!r}")
PY
      printf '%s\n' "${FINGERPRINT}" > "${BUILD_DIR}/.hwpx-stack-fingerprint"
      if [ -e "${VENV_DIR}" ]; then
        mv "${VENV_DIR}" "${VENV_DIR}.invalid.$$"
      fi
      mv "${BUILD_DIR}" "${VENV_DIR}"
    fi

    trap - EXIT INT TERM
    rm -rf "${LOCK_DIR}"
  fi

  exec "${RUNTIME_PYTHON}" -m hwpx_mcp_server.server "$@"
fi

if command -v uvx >/dev/null 2>&1; then
  exec uvx \
    --refresh-package hwpx-mcp-server \
    --refresh-package python-hwpx \
    --with "${CORE_PACKAGE}" \
    --from "${SERVER_PACKAGE}" \
    hwpx-mcp-server "$@"
fi

echo "hwpx-plugin requires uv or uvx to install and run ${SERVER_PACKAGE}. Install uv, or set HWPX_MCP_SERVER_REPO and PYTHON_HWPX_REPO to local checkouts." >&2
exit 127
