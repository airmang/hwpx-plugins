{
  "mcpServers": {
    "hwpx": {
      "command": "uvx",
      "args": [
        "--refresh-package", "python-hwpx-automation",
        "--refresh-package", "python-hwpx",
        "--with", "python-hwpx[preview]==6.3.0",
        "--from", "python-hwpx-automation[mcp,oracle]==7.0.3",
        "hwpx-automation-mcp"
      ],
      "env": {
        "HWPX_AUTOMATION_ADVANCED": "0",
        "HWPX_AUTOMATION_AUTOBACKUP": "1",
        "HWPX_SKILL_VERSION": "2.0.2"
      },
      "env_vars": [
        "HWPX_AUTOMATION_CHROME_PATH",
        "HWPX_MCP_CHROME_PATH"
      ]
    }
  }
}
